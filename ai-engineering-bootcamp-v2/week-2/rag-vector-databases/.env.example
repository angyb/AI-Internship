# OpenAI — embeddings (text-embedding-3-small) and chat completions
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone — create index with 1536 dimensions, cosine metric, serverless
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=zearn-rag
# Hostname only — no https:// prefix
PINECONE_HOST=your-index-host.svc.region.pinecone.io

# Streamlit demo — your deployed FastAPI base URL (no trailing slash)
RAG_API_URL=https://your-app.onrender.com

# Comma-separated document_id values omitted from /ask and /retrieve when no include filter is set.
EXCLUDE_DOCUMENT_IDS=employee_handbook

# Local cross-encoder reranking (free — runs on CPU, no Cohere API)
# Toggle: true to enable, false to disable
RERANK_ENABLED=true
RERANK_CANDIDATES=20
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
