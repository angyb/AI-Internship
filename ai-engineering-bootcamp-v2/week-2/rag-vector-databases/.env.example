# Google ADK agent (POST /agent) — Gemini + Google Search fallback
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional shared secret for POST /agent (extension / remote Streamlit).
# When unset, /agent is open (local/dev). When set, require X-API-Key or Bearer.
AGENT_API_KEY=

# Rate limit POST /agent (per X-Install-Id or client IP)
AGENT_RATE_LIMIT_ENABLED=true
AGENT_RATE_LIMIT_PER_MINUTE=20

# Optional client error telemetry endpoint POST /telemetry
TELEMETRY_ENABLED=false

# OpenAI — set API key below; model names configured in Models section
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone — create index with 1536 dimensions, cosine metric, serverless
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=zearn-rag
# Hostname only — no https:// prefix
PINECONE_HOST=your-index-host.svc.region.pinecone.io

# Streamlit demo — your deployed FastAPI base URL (no trailing slash)
RAG_API_URL=https://your-app.onrender.com

# Render env sync (local only — used by sync_render_env.py, not pushed to Render)
RENDER_API_KEY=rnd_your_render_api_key_here
RENDER_SERVICE_ID=srv_your_service_id_here
# Also set RENDER_API_KEY on the Render service itself so production /health
# can show workspace bandwidth. Remaining account credits are not in the API.
RENDER_INCLUDED_BANDWIDTH_GB=5

# Health-tab usage (optional)
# Admin key with api.usage.read: https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
# Optional spend cap so the Health meter has a denominator (USD)
OPENAI_MONTHLY_BUDGET_USD=
# Gemini Health meter: estimated Flash cost for Ask Z-Bot vs this cap (USD).
# Unset defaults to the Gemini API Tier 1 $250 monthly spend cap.
GEMINI_MONTHLY_BUDGET_USD=
# starter | builder | standard — used for Pinecone storage allowance
PINECONE_PLAN=starter

# OpenAI models
ANSWER_MODEL=gpt-4o
EXTRACTION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RAGAS_JUDGE_MODEL=gpt-4o-mini
GENERATION_TEMPERATURE=0

# Comma-separated document_id values omitted from /ask and /retrieve when no include filter is set.
EXCLUDE_DOCUMENT_IDS=employee_handbook

# Final retrieval context (passed to the LLM)
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=10
MAX_CHUNKS_PER_DOCUMENT=2

# Ingest chunking (used by POST /ingest when query params omitted)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Neighbor-chunk expansion — append chunk_index ± radius for each hit
NEIGHBOR_CHUNKS_ENABLED=true
NEIGHBOR_CHUNK_RADIUS=1
NEIGHBOR_MERGE_ENABLED=true

# Cap LLM context blocks after neighbor expand/merge
MAX_CONTEXT_CHUNKS_ENABLED=true
MAX_CONTEXT_CHUNKS=5

# Local cross-encoder reranking (free — runs on CPU, no Cohere API)
# Toggle: true to enable, false to disable
RERANK_ENABLED=true
RERANK_CANDIDATES=30
# Rerank model: ms-marco-MiniLM-L-6-v2 (default, faster) | ms-marco-MiniLM-L-12-v2 (more accurate, slower)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_MAX_PER_DOC=5

# Two-step generation: extract facts from chunks, then answer from facts only
TWO_STEP_GENERATION=false

# Route questions to type-specific step 1/2 prompts — true | false
QUESTION_ROUTING_ENABLED=true

# Answer style — concise (direct, source-faithful) | complete (include related limits/paths)
ANSWER_VERBOSITY=concise

# Inline markdown-link citations in answers — true | false
CITATIONS_ENABLED=false

# Pre-generation relevance filter (cross-encoder; drops chunks far below best score)
RELEVANCE_FILTER_ENABLED=true
RELEVANCE_MIN_SCORE_GAP=1.0
RELEVANCE_MIN_CHUNKS=1

# Prompt — prefer numeric phrasing when chunks conflict (e.g. "three Boosts" vs "multiple times")
PROMPT_CONFLICT_RESOLUTION_ENABLED=true

# Context assembly — order LLM prompt blocks by cross-encoder score (best first)
CONTEXT_ORDER_BY_RERANK_SCORE=true
